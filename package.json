{
  "name": "@get-air/iptv",
  "version": "0.1.0",
  "description": "Type-safe Promise and Effect toolkit for Xtream, Stalker, M3U, XMLTV, and IPTV search",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "import": "./dist/effect.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "effect-language-service diagnostics --project tsconfig.json --strict --format text && tsc -p tsconfig.json --noEmit",
    "ci": "npm run check && npm test && npm run build && npm run check:exports && npm pack --dry-run --ignore-scripts",
    "ci:act": "act push --job ci",
    "check:exports": "node scripts/check-exports.mjs",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@get-air/cache": "^0.1.0",
    "@get-air/http": "^0.1.0",
    "@iptv/xmltv": "^1.0.1",
    "effect": "^3.22.1",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.19"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/get-air/iptv.git"
  },
  "bugs": {
    "url": "https://github.com/get-air/iptv/issues"
  },
  "homepage": "https://github.com/get-air/iptv#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "iptv",
    "xtream",
    "stalker",
    "ministra",
    "m3u",
    "xmltv",
    "epg",
    "search",
    "effect",
    "typescript"
  ]
}
